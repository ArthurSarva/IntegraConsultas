# Valores locais: preencher a partir do status da CLI; nunca versionar segredos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
# Somente no servidor; nunca usar prefixo NEXT_PUBLIC_ para estas variáveis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios, representados por 64 caracteres hexadecimais.
GOOGLE_TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Autenticação exclusiva da função online; manter fora do frontend e do Git.
GOOGLE_WORKER_SECRET=
